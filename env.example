# Copy to .env (never commit .env)
META_API_URL=
META_API_KEY=
MAX_SPEND_META_USD=40

# Modal shared endpoint (Muse Spark Open)
# 1. pip install modal && modal setup
# 2. modal workspace proxy-tokens create   -> token id (wk-...) and secret (ws-...)
# 3. MODAL_API_KEY = "<id>.<secret>" joined with a period
# 4. curl https://inference.us-west.modal.direct/v1/models -H "Authorization: Bearer <id>.<secret>"
#    and put the Spark Open entry's id (an endpoint hostname) in MODAL_MODEL
MODAL_API_KEY=
MODAL_MODEL=
# MODAL_API_URL=https://inference.us-west.modal.direct/v1/chat/completions   (default)
# MODAL_WIRE=chat            (or "responses" to use Modal's Responses API)
MAX_SPEND_MODAL_USD=40

# Baseten Model APIs (Muse Spark Open). Create a key at app.baseten.co/settings/api_keys
# and enable the model on the Model APIs page of the dashboard first.
BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026   (default; hackathon-specific slug)
MAX_SPEND_BASETEN_USD=40
